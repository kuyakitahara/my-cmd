import sys


def build_targets():
    # 削り用の優先順（高得点・シングル優先）
    throw_targets = []
    for n in range(20, 0, -1):
        throw_targets.append((f"T{n}", n * 3))
    throw_targets.append(("BULL", 50))
    for n in range(20, 0, -1):
        throw_targets.append((f"S{n}", n))
    throw_targets.append(("25", 25))
    for n in range(20, 0, -1):
        throw_targets.append((f"D{n}", n * 2))

    # 上がり用の優先順（ダブルアウト: D20, D16, BULL... の順に優先）
    preferred_doubles = [20, 16, 8, 10, 12, 18, 4, 14, 6, 2]
    rest_doubles = [n for n in range(20, 0, -1) if n not in preferred_doubles]
    finish_targets = [(f"D{n}", n * 2) for n in preferred_doubles]
    finish_targets.append(("BULL", 50))
    finish_targets.extend((f"D{n}", n * 2) for n in rest_doubles)

    return throw_targets, finish_targets


def find_checkout(score, throw_targets, finish_targets):
    # 1本上がり
    for name, val in finish_targets:
        if val == score:
            return name

    # 2本上がり
    for n1, v1 in throw_targets:
        rem = score - v1
        if rem <= 0:
            continue
        for nf, vf in finish_targets:
            if vf == rem:
                return f"{n1} {nf}"

    # 3本上がり
    for n1, v1 in throw_targets:
        for n2, v2 in throw_targets:
            rem = score - v1 - v2
            if rem <= 0:
                continue
            for nf, vf in finish_targets:
                if vf == rem:
                    return f"{n1} {n2} {nf}"

    return "NO OUT"


def main():
    throw_targets, finish_targets = build_targets()
    lines = [line.strip() for line in sys.stdin]

    if not lines or all(line == "" for line in lines):
        print("Error: no input", file=sys.stderr)
        sys.exit(1)

    for line in lines:
        if line == "":
            continue
        try:
            score = int(line)
        except ValueError:
            print(f"Error: invalid integer '{line}'", file=sys.stderr)
            sys.exit(1)

        if score <= 0:
            print(f"Error: score must be positive '{score}'", file=sys.stderr)
            sys.exit(1)

        print(find_checkout(score, throw_targets, finish_targets))


if __name__ == "__main__":
    main()
