import argparse
import sys


def build_targets(mode):
    throw_targets = []
    for n in range(20, 0, -1):
        throw_targets.append((f"T{n}", n * 3))
    throw_targets.append(("BULL", 50))
    for n in range(20, 0, -1):
        throw_targets.append((f"S{n}", n))
    throw_targets.append(("25", 25))
    for n in range(20, 0, -1):
        throw_targets.append((f"D{n}", n * 2))

    preferred_doubles = [20, 16, 8, 10, 12, 18, 4, 14, 6, 2]
    rest_doubles = [n for n in range(20, 0, -1) if n not in preferred_doubles]
    double_targets = [(f"D{n}", n * 2) for n in preferred_doubles]
    double_targets.append(("BULL", 50))
    double_targets.extend((f"D{n}", n * 2) for n in rest_doubles)

    if mode == "double":
        finish_targets = double_targets
    elif mode == "master":
        finish_targets = list(double_targets)
        finish_targets.extend((f"T{n}", n * 3) for n in range(20, 0, -1))
    else:
        finish_targets = [("BULL", 50), ("25", 25)]
        finish_targets.extend((f"S{n}", n) for n in range(20, 0, -1))
        finish_targets.extend((f"D{n}", n * 2) for n in range(20, 0, -1))
        finish_targets.extend((f"T{n}", n * 3) for n in range(20, 0, -1))

    return throw_targets, finish_targets


def find_checkout(score, throw_targets, finish_targets):
    if score > 180:
        return "NO OUT"

    for name, val in finish_targets:
        if val == score:
            return name

    for n1, v1 in throw_targets:
        rem = score - v1
        if rem <= 0:
            continue
        for nf, vf in finish_targets:
            if vf == rem:
                return f"{n1} {nf}"

    for n1, v1 in throw_targets:
        for n2, v2 in throw_targets:
            rem = score - v1 - v2
            if rem <= 0:
                continue
            for nf, vf in finish_targets:
                if vf == rem:
                    return f"{n1} {n2} {nf}"

    return "NO OUT"


def parse_args():
    parser = argparse.ArgumentParser(
        description="Calculate darts checkout routes from remaining scores."
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "-d", "--double", action="store_true", help="double-out mode (default)"
    )
    group.add_argument(
        "-m", "--master", action="store_true", help="master-out mode"
    )
    group.add_argument(
        "-s", "--straight", action="store_true", help="straight-out mode"
    )
    return parser.parse_args()


def main():
    args = parse_args()
    if args.master:
        mode = "master"
    elif args.straight:
        mode = "straight"
    else:
        mode = "double"

    throw_targets, finish_targets = build_targets(mode)
    lines = [line.strip() for line in sys.stdin]

    if not lines or all(line == "" for line in lines):
        print("Error: no input", file=sys.stderr)
        sys.exit(1)

    for line in lines:
        if line == "":
            continue
        try:
            score = int(line)
        except ValueError:
            print(f"Error: invalid integer '{line}'", file=sys.stderr)
            sys.exit(1)

        if score <= 0:
            print(f"Error: score must be positive '{score}'", file=sys.stderr)
            sys.exit(1)

        print(find_checkout(score, throw_targets, finish_targets))


if __name__ == "__main__":
    main()
